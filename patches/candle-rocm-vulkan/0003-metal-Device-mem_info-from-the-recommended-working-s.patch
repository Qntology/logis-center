From 30e502f51e6587f1d8d25f48e44c673999b2d9df Mon Sep 17 00:00:00 2001
From: sungu-che <127634415+sungu-che@users.noreply.github.com>
Date: Tue, 13 Oct 2026 19:45:50 +0000
Subject: [PATCH 3/3] metal: Device::mem_info from the recommended working set

Metal returned Ok(None), so the app's KV-PLAN / residency decisions had no free-memory number
on Apple Silicon. Unified memory: total = MTLDevice.recommendedMaxWorkingSetSize, free = total
- currentAllocatedSize (this process's device allocations).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GcxyAs2y3NUizfXh9YWmxx
---
 candle-core/src/device.rs | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/candle-core/src/device.rs b/candle-core/src/device.rs
index 6a20119..2212585 100644
--- a/candle-core/src/device.rs
+++ b/candle-core/src/device.rs
@@ -775,7 +775,18 @@ impl Device {
             Self::Cuda(d) => Ok(Some(d.mem_info()?)),
             Self::Rocm(d) => Ok(Some(d.mem_info()?)),
             Self::Vulkan(d) => Ok(Some(d.mem_info()?)),
-            Self::Cpu | Self::Metal(_) | Self::OpenCl(_) => Ok(None),
+            // Unified memory: the GPU budget is the device's recommended working set; what this
+            // process has allocated on the device (buffers, heaps) counts as used.
+            #[cfg(feature = "metal")]
+            Self::Metal(d) => {
+                let dev = d.metal_device();
+                let total = dev.recommended_max_working_set_size();
+                let used = dev.current_allocated_size();
+                Ok(Some((total.saturating_sub(used), total)))
+            }
+            #[cfg(not(feature = "metal"))]
+            Self::Metal(_) => Ok(None),
+            Self::Cpu | Self::OpenCl(_) => Ok(None),
         }
     }
 
