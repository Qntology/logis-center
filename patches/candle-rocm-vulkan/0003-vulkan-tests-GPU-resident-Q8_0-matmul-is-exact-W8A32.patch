From a08ba343b009f6acf5612fe4f22181ac875bf224 Mon Sep 17 00:00:00 2001
From: sungu-che <127634415+sungu-che@users.noreply.github.com>
Date: Tue, 13 Oct 2026 23:05:34 +0000
Subject: [PATCH 3/7] vulkan tests: GPU-resident Q8_0 matmul is exact W8A32;
 f16 forward_exact on Vulkan in f32

MoltenVK (macos-15 runner) still failed vulkan_tests::quantized_dequantize_and_matmul with
"Q8_0 qmatmul rows 1: diff 0.247" after the barrier change, so that change was not the cause
(it remains a correct translation of GLSL barrier(), but it fixed nothing observed). The cause is
the test's reference: on unified-memory devices Q8_0 weights live on the GPU (GpuQ8) from the
first use and multiply the f32 activations exactly (x * dequant(W)^T), while the CPU reference
(and the host path) quantizes the activations to Q8_0 first. Measured on the CPU at the test's
shapes: |QMatMul - x*dequant(W)^T| = 0.18-0.62. lavapipe never uses GpuQ8 (CPU-type device) and
discrete GPUs only from the second use, which is why it passed elsewhere. The Q8_0 checks now
accept either reference.

forward_exact: Vulkan's f16 matmul runs on the host gemm, so w8a16_generic_cuda::vulkan showed the
same Apple Silicon f16-accumulation error (max_rel 5.69e-3) as the CPU; it gets the same f32
accumulation. x86: quantized_tests 42/42; lavapipe: vulkan_tests quantized 1/1, w8a16 4/4.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GcxyAs2y3NUizfXh9YWmxx
---
 candle-core/src/quantized/mod.rs  | 10 +++++---
 candle-core/tests/vulkan_tests.rs | 41 ++++++++++++++++++++++++-------
 2 files changed, 38 insertions(+), 13 deletions(-)

diff --git a/candle-core/src/quantized/mod.rs b/candle-core/src/quantized/mod.rs
index 64e6bb3..c46575e 100644
--- a/candle-core/src/quantized/mod.rs
+++ b/candle-core/src/quantized/mod.rs
@@ -979,10 +979,12 @@ impl QTensor {
             _ => {
                 // The CPU backend has no bf16 matmul: bf16 prefill runs in f32 there.
                 let cpu_bf16 = dtype == DType::BF16 && xs.device().is_cpu();
-                // f16 on the CPU: the gemm crate's f16 kernel accumulates in f16 on AArch64 with
-                // FEAT_FP16 (Apple Silicon: max_rel 5.7e-3 vs 5.1e-4 on x86 in w8a16_generic_cpu).
-                // Keep the CUDA semantics instead: weight rounded to f16, f32 accumulation.
-                let cpu_f16 = dtype == DType::F16 && xs.device().is_cpu() && rows > EXACT_MV_MAX_ROWS;
+                // f16 on the CPU (and on Vulkan, whose f16 matmul runs on the host gemm): the gemm
+                // crate's f16 kernel accumulates in f16 on AArch64 with FEAT_FP16 (Apple Silicon:
+                // max_rel 5.7e-3 vs 5.1e-4 on x86 in w8a16_generic_cpu / _cuda::vulkan). Keep the
+                // CUDA semantics instead: weight rounded to f16, f32 accumulation.
+                let host_gemm = xs.device().is_cpu() || xs.device().is_vulkan();
+                let cpu_f16 = dtype == DType::F16 && host_gemm && rows > EXACT_MV_MAX_ROWS;
                 if cpu_f16 {
                     let w = self.dequantize_to(DType::F16, xs.device())?.to_dtype(DType::F32)?;
                     return linear_forward(&xs.to_dtype(DType::F32)?, &w)?.to_dtype(dtype);
diff --git a/candle-core/tests/vulkan_tests.rs b/candle-core/tests/vulkan_tests.rs
index 8e32452..c2b55ec 100644
--- a/candle-core/tests/vulkan_tests.rs
+++ b/candle-core/tests/vulkan_tests.rs
@@ -785,15 +785,35 @@ fn quantized_dequantize_and_matmul() -> Result<()> {
 
             let mm_cpu = QMatMul::from_qtensor(QTensor::quantize(&w, dtype)?)?;
             let mm_gpu = QMatMul::from_qtensor(QTensor::quantize_onto(&w, dtype, dev)?)?;
+            // Q8_0 weights resident on the GPU (GpuQ8: unified-memory devices such as MoltenVK from
+            // the first use, discrete ones once mirrored) multiply the f32 activations exactly,
+            // x · dequant(W)ᵀ. The host path, like the CPU backend, first quantizes the activations
+            // to Q8_0 (llama.cpp vec_dot), which is 0.2-0.6 away at k = 512. Both are correct; the
+            // Vulkan result has to match one of them.
+            let q8 = dtype == GgmlDType::Q8_0;
+            let max_diff = |a: &Tensor, b: &Tensor| -> Result<f32> {
+                (a.to_device(&Device::Cpu)?.to_dtype(DType::F32)? - b.to_dtype(DType::F32)?)?
+                    .abs()?
+                    .max_all()?
+                    .to_scalar::<f32>()
+            };
+            let exact_ref = |x: &Tensor| -> Result<Tensor> {
+                x.to_dtype(DType::F32)?.broadcast_matmul(&deq_cpu.t()?)
+            };
+            let diff_q = |r_gpu: &Tensor, x: &Tensor, r_ref: &Tensor| -> Result<f32> {
+                let d = max_diff(r_gpu, r_ref)?;
+                if q8 {
+                    Ok(d.min(max_diff(r_gpu, &exact_ref(x)?)?))
+                } else {
+                    Ok(d)
+                }
+            };
             for rows in [1usize, 3, 8, 9, 33] {
                 let x = randn(&[1, rows, k], DType::F32)?;
                 let r_cpu = mm_cpu.forward(&x)?;
                 let r_gpu = mm_gpu.forward(&x.to_device(dev)?)?;
                 assert!(r_gpu.device().is_vulkan());
-                let diff = (r_gpu.to_device(&Device::Cpu)? - &r_cpu)?
-                    .abs()?
-                    .max_all()?
-                    .to_scalar::<f32>()?;
+                let diff = diff_q(&r_gpu, &x, &r_cpu)?;
                 assert!(diff < 1e-3, "{dtype:?} qmatmul rows {rows}: diff {diff}");
                 if matches!(mm_cpu, QMatMul::QTensor(_)) {
                     let r_mixed = mm_cpu.forward(&x.to_device(dev)?)?;
@@ -810,10 +830,7 @@ fn quantized_dequantize_and_matmul() -> Result<()> {
                 let xs = randn(&[rows, 2 * k], DType::F32)?.narrow(1, 3, k)?;
                 let r_s = mm_gpu.forward(&xs.to_device(dev)?)?;
                 let r_s_ref = mm_cpu.forward(&xs.contiguous()?)?;
-                let diff = (r_s.to_device(&Device::Cpu)? - &r_s_ref)?
-                    .abs()?
-                    .max_all()?
-                    .to_scalar::<f32>()?;
+                let diff = diff_q(&r_s, &xs.contiguous()?, &r_s_ref)?;
                 assert!(
                     diff < 1e-3,
                     "{dtype:?} strided input rows {rows}: diff {diff}"
@@ -823,9 +840,15 @@ fn quantized_dequantize_and_matmul() -> Result<()> {
                 let x16 = randn(&[2, k], DType::F16)?;
                 let r16 = mm_gpu.forward(&x16.to_device(dev)?)?;
                 assert_eq!(r16.dtype(), DType::F16);
-                let r16_ref = mm_cpu
+                let mut r16_ref = mm_cpu
                     .forward(&x16.to_dtype(DType::F32)?)?
                     .to_dtype(DType::F16)?;
+                if q8 {
+                    let exact = exact_ref(&x16)?.to_dtype(DType::F16)?;
+                    if max_diff(&r16, &exact)? < max_diff(&r16, &r16_ref)? {
+                        r16_ref = exact;
+                    }
+                }
                 assert_close(&r16, &r16_ref, "qmatmul f16 input")?;
                 let ids = Tensor::new(&[[3u32, 0], [39, 7]], &Device::Cpu)?;
                 let e_gpu = q_gpu.embedding(&ids.to_device(dev)?)?;
