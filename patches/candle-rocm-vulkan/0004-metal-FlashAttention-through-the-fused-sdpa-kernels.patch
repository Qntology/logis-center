From 3ad50503df73d4bd21d671aff73ae63b220b2351 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 03:16:11 +0000
Subject: [PATCH 04/10] metal: FlashAttention through the fused sdpa kernels

Metal had no fused attention: BackendSwitches::allows() returned false for it, so every
flash-attn call took the unfused matmul + softmax path. flash_attn_with_config now runs the
scaled_dot_product_attention kernels of candle-metal-kernels (MLX port, candle_nn::ops::sdpa:
GQA, causal aligned bottom-right like the other backends, vector kernel for decode, two-pass
above 1024 keys) for the plain and causal cases; sliding windows, ALiBi, soft-capping, FP8
and other head dims keep the unfused path. BackendSwitches gains a metal switch ("metal" in
CANDLE_*_BACKENDS lists); TurboQuant has no Metal kernels and stays off there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GcxyAs2y3NUizfXh9YWmxx
---
 candle-core/src/accel/config.rs | 14 +++++++--
 candle-nn/src/flash_attn.rs     | 50 +++++++++++++++++++++++++++++++++
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/candle-core/src/accel/config.rs b/candle-core/src/accel/config.rs
index f858583..24bfcf0 100644
--- a/candle-core/src/accel/config.rs
+++ b/candle-core/src/accel/config.rs
@@ -146,6 +146,9 @@ pub struct BackendSwitches {
     pub rocm: bool,
     pub vulkan: bool,
     pub cpu: bool,
+    /// Metal: FlashAttention runs the fused `scaled_dot_product_attention` kernels of
+    /// candle-metal-kernels (no TurboQuant kernels on Metal).
+    pub metal: bool,
 }
 
 impl Default for BackendSwitches {
@@ -161,6 +164,7 @@ impl BackendSwitches {
             rocm: true,
             vulkan: true,
             cpu: true,
+            metal: true,
         }
     }
 
@@ -170,6 +174,7 @@ impl BackendSwitches {
             rocm: false,
             vulkan: false,
             cpu: false,
+            metal: false,
         }
     }
 
@@ -188,6 +193,7 @@ impl BackendSwitches {
                 "rocm" | "hip" | "amd" => out.rocm = true,
                 "vulkan" | "vk" => out.vulkan = true,
                 "cpu" => out.cpu = true,
+                "metal" | "mps" | "apple" => out.metal = true,
                 _ => return Err(format!("unknown backend {part:?} in {s:?}")),
             }
         }
@@ -200,6 +206,8 @@ impl BackendSwitches {
             crate::Device::Cuda(_) => self.cuda,
             crate::Device::Rocm(_) => self.rocm,
             crate::Device::Vulkan(_) => self.vulkan,
+            crate::Device::Metal(_) => self.metal,
+            #[allow(unreachable_patterns)]
             _ => false,
         }
     }
@@ -445,9 +453,11 @@ impl AccelConfig {
             && (device.is_cpu() || FLASH_ATTN_COMPILED)
     }
 
-    /// Whether the TurboQuant GPU kernels may run on `device`.
+    /// Whether the TurboQuant GPU kernels may run on `device` (there are no Metal kernels).
     pub fn turbo_quant_kernels_allowed(&self, device: &crate::Device) -> bool {
-        self.turbo_quant.backends.allows(device) && (device.is_cpu() || TURBO_QUANT_COMPILED)
+        self.turbo_quant.backends.allows(device)
+            && !device.is_metal()
+            && (device.is_cpu() || TURBO_QUANT_COMPILED)
     }
 }
 
diff --git a/candle-nn/src/flash_attn.rs b/candle-nn/src/flash_attn.rs
index 24657c0..3b0fb4c 100644
--- a/candle-nn/src/flash_attn.rs
+++ b/candle-nn/src/flash_attn.rs
@@ -465,11 +465,61 @@ fn debug_choice(q: &Tensor, fused: bool) {
     );
 }
 
+/// Metal: the fused `scaled_dot_product_attention` kernels of candle-metal-kernels (MLX port,
+/// [`crate::ops::sdpa`]: GQA, causal aligned bottom-right like the other backends, one-pass
+/// vector kernel for decode, two-pass above 1024 keys). `None` for the options they do not
+/// cover (sliding windows, ALiBi, soft-capping, FP8, other head dims), which stay unfused.
+#[cfg(feature = "metal")]
+fn metal_sdpa(q: &Tensor, k: &Tensor, v: &Tensor, cfg: &FlashAttnConfig) -> Result<Option<Tensor>> {
+    let causal = match (cfg.window_size_left, cfg.window_size_right) {
+        (None, None) => false,
+        (None, Some(0)) => true,
+        _ => return Ok(None),
+    };
+    if cfg.softcap.is_some() || cfg.alibi_slopes.is_some() {
+        return Ok(None);
+    }
+    let dt = q.dtype();
+    if !matches!(dt, DType::F32 | DType::F16 | DType::BF16) || k.dtype() != dt || v.dtype() != dt {
+        return Ok(None);
+    }
+    let (b, sq, hq, d) = q.dims4()?;
+    let (bk, skv, hkv, dk) = k.dims4()?;
+    if v.dims4()? != (bk, skv, hkv, d) || bk != b || dk != d || hkv == 0 || hq % hkv != 0 || sq == 0 || skv == 0 {
+        return Ok(None);
+    }
+    let head_dim_ok = matches!(d, 32 | 64 | 72 | 80 | 96 | 128 | 256 | 512);
+    if !head_dim_ok || (sq > 1 && d == 512 && dt == DType::F32) || (causal && sq > skv) {
+        return Ok(None);
+    }
+    let bhsd = |x: &Tensor| x.transpose(1, 2)?.contiguous();
+    let o = crate::ops::sdpa(
+        &bhsd(q)?,
+        &bhsd(k)?,
+        &bhsd(v)?,
+        None,
+        causal && sq > 1,
+        cfg.softmax_scale,
+        1.0,
+    )?;
+    Ok(Some(o.transpose(1, 2)?.contiguous()?))
+}
+
 fn run(q: &Tensor, k: &Tensor, v: &Tensor, op: &FlashAttnOp) -> Result<Tensor> {
     let fused = op
         .cfg
         .fused
         .unwrap_or_else(|| accel::config().flash_attn_allowed(q.device()));
+    #[cfg(feature = "metal")]
+    if fused && q.device().is_metal() {
+        debug_choice(q, true);
+        match metal_sdpa(q, k, v, &op.cfg) {
+            Ok(Some(t)) => return Ok(t),
+            Ok(None) => {}
+            Err(e) if op.cfg.strict => return Err(e),
+            Err(e) => warn_fallback(&e),
+        }
+    }
     let supported = matches!(
         q.device(),
         Device::Cpu | Device::Cuda(_) | Device::Rocm(_) | Device::Vulkan(_)
