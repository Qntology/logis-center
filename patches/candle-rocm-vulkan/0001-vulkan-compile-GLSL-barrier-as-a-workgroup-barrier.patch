From c663a2320bba867a925d6731907fc7f156e86b64 Mon Sep 17 00:00:00 2001
From: sungu-che <127634415+sungu-che@users.noreply.github.com>
Date: Tue, 13 Oct 2026 22:38:05 +0000
Subject: [PATCH 01/12] vulkan: compile GLSL barrier() as a workgroup barrier

naga 27's GLSL front end lowers barrier() to ControlBarrier(Barrier::all()); the SPIR-V back end
then picks a *subgroup* execution scope because SUB_GROUP is among the flags. GLSL barrier() is a
workgroup execution barrier, and the shaders rely on it across subgroups (shared tiles, shared
reductions). Drivers that honour the scope literally race: on MoltenVK (macos-15 GitHub runner,
Apple Paravirtual device) vulkan_tests::quantized_dequantize_and_matmul failed with
"Q8_0 qmatmul rows 1: diff 0.309" (q8_gemv shared reduction) while dequantize was exact.
Drop SUB_GROUP from workgroup barriers after parsing. lavapipe: vulkan_tests 19/19,
vulkan_accel_tests 3/3, candle-nn accel_vulkan 4/4 still pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GcxyAs2y3NUizfXh9YWmxx
---
 candle-core/src/vulkan_backend/shaders.rs | 47 ++++++++++++++++++++++-
 1 file changed, 46 insertions(+), 1 deletion(-)

diff --git a/candle-core/src/vulkan_backend/shaders.rs b/candle-core/src/vulkan_backend/shaders.rs
index f70754c..6e2a6e5 100644
--- a/candle-core/src/vulkan_backend/shaders.rs
+++ b/candle-core/src/vulkan_backend/shaders.rs
@@ -196,9 +196,10 @@ fn glsl_to_spirv(source: &str) -> Result<Vec<u32>> {
 
     let options = Options::from(naga::ShaderStage::Compute);
     let mut frontend = Frontend::default();
-    let module = frontend
+    let mut module = frontend
         .parse(&options, source)
         .map_err(|e| Error::Msg(format!("vulkan shader parse failed: {e:?}")))?;
+    workgroup_barriers(&mut module);
     let mut validator = Validator::new(ValidationFlags::all(), Capabilities::all());
     let info = validator
         .validate(&module)
@@ -216,6 +217,50 @@ fn glsl_to_spirv(source: &str) -> Result<Vec<u32>> {
     Ok(words)
 }
 
+/// naga 27's GLSL front end lowers `barrier()` to `ControlBarrier(Barrier::all())`, and the SPIR-V
+/// back end picks a *subgroup* execution scope whenever `SUB_GROUP` is among the flags. GLSL's
+/// `barrier()` is a workgroup execution barrier (plus shared / buffer memory ordering), and the
+/// shaders here rely on that across subgroups (shared-memory tiles and reductions). Drivers that
+/// honour the scope literally (MoltenVK maps it to `simdgroup_barrier`) then race. Drop `SUB_GROUP`
+/// so every barrier is emitted as OpControlBarrier(Workgroup, Device, AcquireRelease | Uniform |
+/// Workgroup | Image).
+fn workgroup_barriers(module: &mut naga::Module) {
+    fn fix(block: &mut naga::Block) {
+        for st in block.iter_mut() {
+            match st {
+                naga::Statement::ControlBarrier(flags) | naga::Statement::MemoryBarrier(flags) => {
+                    if flags.contains(naga::Barrier::WORK_GROUP) {
+                        flags.remove(naga::Barrier::SUB_GROUP);
+                    }
+                }
+                naga::Statement::Block(b) => fix(b),
+                naga::Statement::If { accept, reject, .. } => {
+                    fix(accept);
+                    fix(reject);
+                }
+                naga::Statement::Switch { cases, .. } => {
+                    for c in cases.iter_mut() {
+                        fix(&mut c.body);
+                    }
+                }
+                naga::Statement::Loop {
+                    body, continuing, ..
+                } => {
+                    fix(body);
+                    fix(continuing);
+                }
+                _ => {}
+            }
+        }
+    }
+    for (_, f) in module.functions.iter_mut() {
+        fix(&mut f.body);
+    }
+    for ep in module.entry_points.iter_mut() {
+        fix(&mut ep.function.body);
+    }
+}
