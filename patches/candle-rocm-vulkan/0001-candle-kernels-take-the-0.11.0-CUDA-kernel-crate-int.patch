+template <typename T>
+__device__ void
+fast_max(const size_t src_numel, const size_t el_to_sum_per_block,
+         const size_t num_dims, const size_t *info, const T *src, T *dst) {
+  const size_t *dims = info;
+  const size_t *strides = info + num_dims;
