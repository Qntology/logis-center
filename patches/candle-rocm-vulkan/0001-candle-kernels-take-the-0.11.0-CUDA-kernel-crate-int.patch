+        case  56: instantiate_mmq_q5_k< 56>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case  64: instantiate_mmq_q5_k< 64>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case  72: instantiate_mmq_q5_k< 72>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case  80: instantiate_mmq_q5_k< 80>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case  88: instantiate_mmq_q5_k< 88>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case  96: instantiate_mmq_q5_k< 96>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case 104: instantiate_mmq_q5_k<104>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case 112: instantiate_mmq_q5_k<112>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case 120: instantiate_mmq_q5_k<120>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        case 128: instantiate_mmq_q5_k<128>(tmp_fixup, args, stream, cc, nsm, smpbo, warp_size_host); break;
+        default: break;
+    }
