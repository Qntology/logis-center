From eaeb66abd02ba3c0f7242da28723354c263acbf4 Mon Sep 17 00:00:00 2001
From: mac-verify CI <mac-verify@users.noreply.github.com>
Date: Wed, 14 Oct 2026 19:15:35 +0000
Subject: [PATCH 2/2] candle-kernels: half max/min helpers that work with CUDA
 13 below sm_80

compatibility.cuh defined __hmax_nan / __hmin_nan(__half) for __CUDA_ARCH__ < 800, which CUDA 13 headers also
declare, so nvcc 13.2 stopped with "function __hmax_nan(__half, __half) has already been defined" for every
architecture below sm_80. The half helpers are now candle_hmax_nan / candle_hmin_nan: the toolkit's function on
sm_80 and newer (unchanged), the old portable form below. Callers: atomicMaxf / atomicMinf (4) and the __half
maxg / ming. The bf16 versions still call the toolkit directly.

CUDA 12 behaviour is unchanged. Verified against mock CUDA 12-like and 13-like headers on a host compiler;
a real nvcc build is the job of the CI.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GcxyAs2y3NUizfXh9YWmxx
---
 candle-kernels/FORK-NOTES.md         | 21 ++++++++++++++++++-
 candle-kernels/src/compatibility.cuh | 30 ++++++++++++++++++++--------
 candle-kernels/src/cuda_utils.cuh    |  4 ++--
 3 files changed, 44 insertions(+), 11 deletions(-)

diff --git a/candle-kernels/FORK-NOTES.md b/candle-kernels/FORK-NOTES.md
index 93e4aac..be4cc44 100644
--- a/candle-kernels/FORK-NOTES.md
+++ b/candle-kernels/FORK-NOTES.md
@@ -10,4 +10,23 @@ Nothing else in the workspace uses this crate. Keep it the only copy in a build:
 
 ## Changes against the crates.io release
 
-None yet in the commit that added the copy. Later commits list their changes below.
+### 1. CUDA 13: `__hmax_nan` / `__hmin_nan` for `__half` (src/compatibility.cuh, src/cuda_utils.cuh)
+
+`compatibility.cuh` defined `__hmax_nan(__half, __half)` and `__hmin_nan(__half, __half)` for
+`__CUDA_ARCH__ < 800`, because CUDA 12 and older only declare them for sm_80 and newer. CUDA 13 declares them for
+every architecture, so building for any GPU below sm_80 with CUDA 13.2 failed:
+
+    compatibility.cuh(11): error: function "__hmax_nan(__half, __half)" has already been defined
+    (previous definition at line 3399 of ...\CUDA\v13.2\include\cuda_fp16.hpp)
+
+Whether a toolkit already has the functions cannot be tested in the preprocessor, so the half helpers got names no
+toolkit uses: `candle_hmax_nan` / `candle_hmin_nan`. They call the toolkit's function for sm_80 and newer (as before)
+and the portable form below that (the same code the old shim had). The four uses in `atomicMaxf` / `atomicMinf` and the
+`__half` `maxg` / `ming` in `cuda_utils.cuh` call them. The `__nv_bfloat16` versions (sm_80+ only) are unchanged.
+
+Behaviour on CUDA 12 is identical (same function per architecture); CUDA 13 builds below sm_80 now compile.
+Checked with the real headers replaced by mock ones on a host compiler (CUDA 12-like and CUDA 13-like toolkit,
+sm_53 / 61 / 75 / 80 and the host pass; the original reproduces the redefinition error, the patched one compiles and
+gives the same NaN-propagating results). It is built with a real nvcc by the cross-verify CI of logis-center.
+
+Upstream candle-kernels has the same problem; this change can be offered to huggingface/candle.
diff --git a/candle-kernels/src/compatibility.cuh b/candle-kernels/src/compatibility.cuh
index 8cb8f14..601a9f7 100644
--- a/candle-kernels/src/compatibility.cuh
+++ b/candle-kernels/src/compatibility.cuh
@@ -7,14 +7,28 @@
 
 // FIXME: the minimum compute capabilities are just guesses since the table is not specific enough
 
-#if __CUDA_ARCH__ < 800
-__device__ __forceinline__ __half __hmax_nan(__half a, __half b) {
+// NaN-propagating max / min of two __half values.
+//
+// candle-rocm-vulkan: CUDA 12 and older only declare __hmax_nan / __hmin_nan(__half) for sm_80 and newer, which is
+// why this file used to define them for `__CUDA_ARCH__ < 800`. CUDA 13 declares them for every architecture, so
+// that second definition is a redefinition error ("function __hmax_nan(__half, __half) has already been defined").
+// Whether a toolkit has them cannot be tested in the preprocessor, so the kernels call these helpers instead: under
+// a name no toolkit uses, with the toolkit's own function where it is known to exist (sm_80+) and the portable
+// form elsewhere. The bf16 versions (sm_80+ only) still call the toolkit's __hmax_nan / __hmin_nan directly.
+__device__ __forceinline__ __half candle_hmax_nan(__half a, __half b) {
+#if __CUDA_ARCH__ >= 800
+    return __hmax_nan(a, b);
+#else
     return __hisnan(a) ? a : (__hisnan(b) ? b : __hmax(a, b));
+#endif
 }
-__device__ __forceinline__ __half __hmin_nan(__half a, __half b) {
+__device__ __forceinline__ __half candle_hmin_nan(__half a, __half b) {
+#if __CUDA_ARCH__ >= 800
+    return __hmin_nan(a, b);
+#else
     return __hisnan(a) ? a : (__hisnan(b) ? b : __hmin(a, b));
-}
 #endif
+}
 
 #if __CUDA_ARCH__ < 600
 // Copied from https://docs.nvidia.com/cuda/cuda-c-programming-guide/#atomic-functions
@@ -71,7 +85,7 @@ __device__ __forceinline__ __half atomicMaxf(__half* address, __half val) {
         assumed = old;
         unsigned int hmax;
         hmax = unaligned ? (old >> 16) : (old & 0xffff);
-        hmax = __half_as_ushort(__hmax_nan(val, __ushort_as_half(hmax))); 
+        hmax = __half_as_ushort(candle_hmax_nan(val, __ushort_as_half(hmax))); 
         old = atomicCAS(address_as_ui, assumed,
             unaligned ? (old & 0xffff) | (hmax << 16) : (old & 0xffff0000) | hmax
         );
@@ -85,7 +99,7 @@ __device__ __forceinline__ __half atomicMaxf(__half* address, __half val) {
     unsigned short int assumed;
     do {
         assumed = old;
-        old = atomicCAS(casted_address, assumed, __half_as_ushort(__hmax_nan(val, __ushort_as_half(assumed))));
+        old = atomicCAS(casted_address, assumed, __half_as_ushort(candle_hmax_nan(val, __ushort_as_half(assumed))));
     // Note: uses integer comparison to avoid hang in case of NaN (since NaN != NaN)
     } while (assumed != old);
     return __ushort_as_half(old);
@@ -123,7 +137,7 @@ __device__ __forceinline__ __half atomicMinf(__half* address, __half val) {
         assumed = old;
         unsigned int hmin;
         hmin = unaligned ? (old >> 16) : (old & 0xffff);
-        hmin = __half_as_ushort(__hmin_nan(val, __ushort_as_half(hmin))); 
+        hmin = __half_as_ushort(candle_hmin_nan(val, __ushort_as_half(hmin))); 
         old = atomicCAS(address_as_ui, assumed,
             unaligned ? (old & 0xffff) | (hmin << 16) : (old & 0xffff0000) | hmin
         );
@@ -137,7 +151,7 @@ __device__ __forceinline__ __half atomicMinf(__half* address, __half val) {
     unsigned short int assumed;
     do {
         assumed = old;
-        old = atomicCAS(casted_address, assumed, __half_as_ushort(__hmin_nan(val, __ushort_as_half(assumed))));
+        old = atomicCAS(casted_address, assumed, __half_as_ushort(candle_hmin_nan(val, __ushort_as_half(assumed))));
     // Note: uses integer comparison to avoid hang in case of NaN (since NaN != NaN)
     } while (assumed != old);
     return __ushort_as_half(old);
diff --git a/candle-kernels/src/cuda_utils.cuh b/candle-kernels/src/cuda_utils.cuh
index eb1400b..889cada 100644
--- a/candle-kernels/src/cuda_utils.cuh
+++ b/candle-kernels/src/cuda_utils.cuh
@@ -165,14 +165,14 @@ __device__ __forceinline__ __half sqrtg(__half a) { return hsqrt(a); }
 __device__ __forceinline__ __half cosg(__half a) { return hcos(a); }
 __device__ __forceinline__ __half sing(__half a) { return hsin(a); }
 __device__ __forceinline__ __half recipg(__half a) { __half one = 1.0; return one / a; }
-__device__ __forceinline__ __half maxg(__half a, __half b) { return __hmax_nan(a, b); }
+__device__ __forceinline__ __half maxg(__half a, __half b) { return candle_hmax_nan(a, b); }
 __device__ __forceinline__ __half tanhg(__half a) { return __float2half(tanhf(__half2float(a))); }
 __device__ __forceinline__ __half erfg(__half a) { return __float2half(erff(__half2float(a))); }
 __device__ __forceinline__ __half ceilg(__half a) { return __float2half(ceilf(__half2float(a))); }
 __device__ __forceinline__ __half floorg(__half a) { return __float2half(floorf(__half2float(a))); }
 __device__ __forceinline__ __half roundg(__half a) { return __float2half(roundf(__half2float(a))); }
 __device__ __forceinline__ __half normcdfg(__half a) { return __float2half(normcdff(__half2float(a))); }
-__device__ __forceinline__ __half ming(__half a, __half b) { return __hmin_nan(a, b); }
+__device__ __forceinline__ __half ming(__half a, __half b) { return candle_hmin_nan(a, b); }
 __device__ __forceinline__ __half logg(__half a) { return hlog(a); }
 __device__ __forceinline__ __half expg(__half a) { return hexp(a); }
 __device__ __forceinline__ __half absg(__half a) { return __habs(a); }
