-//! g = neg_a * softplus(a + dt_bias)   (torch threshold 20),  beta = sigmoid(b)
-//! S1 = exp(g) S;  delta = beta (v - S1^T k);  S' = S1 + k delta^T;  o = S'^T q
+//! g = neg_a * softplus(a + dt_bias) (torch threshold 20), beta = sigmoid(b)
+//! S *= exp(g);  m = S^T k;  d = beta (v - m);  S += k d^T;  o = S^T q
