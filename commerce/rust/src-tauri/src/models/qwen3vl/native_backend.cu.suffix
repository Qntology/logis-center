    void cuda_element_mul_f16(half* d_dst, const half* d_src, int size) {
        element_mul_kernel_f16<<<(size + 255)/256, 256>>>(d_dst, d_src, size);
    }
}

// [2026-F32-PRECISION-RESTORE]
__global__ void high_precision_matmul_f32_bias_kernel(const float* A, const float* B, const float* Bias, float* C, int M, int N, int K) {
    int row = blockIdx.y * blockDim.y + threadIdx.y;
    int col = blockIdx.x * blockDim.x + threadIdx.x;
    if (row < M && col < N) {
        float acc = 0.0f;
        for (int i = 0; i < K; ++i) {
            acc += A[row * K + i] * B[col * K + i];
        }
        if (Bias) acc += Bias[col];
        C[row * N + col] = acc;
    }
}

// [2026-LOGIT-SHARPENING]
__global__ void logit_sharpening_kernel_f32(float* d_logits, float factor, int size) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < size) {
        d_logits[idx] *= factor;
    }
}

extern "C" {
    void high_precision_matmul_f32_bias(const float* d_i, const float* d_w, const float* d_b, float* d_o, int m, int n, int k) {
        dim3 block(16, 16);
        dim3 grid((n + 15) / 16, (m + 31) / 32);
        high_precision_matmul_f32_bias_kernel<<<grid, block>>>(d_i, d_w, d_b, d_o, m, n, k);
    }

    void cuda_logit_sharpening_f32(float* d_logits, float factor, int size) {
        logit_sharpening_kernel_f32<<<(size + 255)/256, 256>>>(d_logits, factor, size);
    }
}
