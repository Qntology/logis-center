{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "!!! LOGIS NEW !!!",
  "version": "0.1.10",
  "identifier": "com.logis.scanner.v110",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist/mobile"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Logis Mobile",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}